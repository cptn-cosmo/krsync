# Maintainer: CPTN Cosmo <cosmo@geeks.gay>
pkgname=krsync
pkgver=0.1.1
pkgrel=1
pkgdesc='Qt 6 / Kirigami front end for rsync, in the spirit of Grsync'
arch=('x86_64' 'aarch64')
url='https://github.com/cptn-cosmo/krsync'
license=('GPL-3.0-or-later')
depends=(
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
  'kconfig'
  'kcoreaddons'
  'kcrash'
  'kdbusaddons'
  'ki18n'
  'kiconthemes'
  'kirigami'
  'kirigami-addons'
  'knotifications'
  'qqc2-desktop-style'
  'qt6-base'
  'qt6-declarative'
  'rsync'
)
makedepends=('cmake' 'extra-cmake-modules' 'ninja')
optdepends=('polkit: run syncs as administrator via pkexec')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('860bf0049f99b746f0ddf55139298758e4873bfa48ed2a77dd5c7d30109ce9aa')

build() {
  cmake -B build -S "$pkgname-$pkgver" -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=None \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
